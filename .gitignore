/node_modules

# Next.js
/.next/
/out/

# Build / tooling
/dist
/tmp
/coverage

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
