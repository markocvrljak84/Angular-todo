# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Vercel
.vercel

# Env (local secrets)
.env*.local

# System files
.DS_Store
Thumbs.db
