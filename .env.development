# Reliable file watching when the editor saves files (Cursor, VS Code, etc.).
WATCHPACK_POLLING=true

# Form email (SMTP): set SMTP_HOST, SMTP_USER, SMTP_PASS, etc. in .env.local (not committed).

# Optional Cloudflare Turnstile for form human verification (recommended in production)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
