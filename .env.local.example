# Copy to .env.local and fill in SMTP_PASS (never commit .env.local).

# Canonical production URL (no trailing slash) — used for sitemap, canonical tags & JSON-LD.
NEXT_PUBLIC_SITE_URL=https://velebit-starspeak.com

# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@velebit-starspeak.com
# App / mailbox password for your SMTP provider.
SMTP_PASS=
MAIL_FROM=info@velebit-starspeak.com
MAIL_TO=info@velebit-starspeak.com
